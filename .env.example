# -----------------------------------------------------------------------------
# n8n-hubspot-contact-merge-conflict-resolver: environment template
# Copy to .env (local scripts) and set the same keys on your n8n host.
# Never commit real values. Every value below is a placeholder.
# -----------------------------------------------------------------------------

# --- Safety switches (keep both true until you have reviewed the audit log) ---
# Plan merges and log them, but write nothing to HubSpot.
DRY_RUN=true
# Marks audit entries as sandbox. Required before HUBSPOT_SKIP_SIGNATURE_CHECK is honoured.
SANDBOX_MODE=true

# --- HubSpot app ---
# The private app token is stored in the n8n credential "HubSpot Private App Token",
# not read from env by the workflow. It is listed here for reference only.
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=REPLACE_WITH_HUBSPOT_PRIVATE_APP_TOKEN
# The app's client secret, used to verify X-HubSpot-Signature-v3.
HUBSPOT_CLIENT_SECRET=REPLACE_WITH_HUBSPOT_APP_CLIENT_SECRET
# The app's ID. Events this app causes are ignored to prevent feedback loops.
HUBSPOT_APP_ID=REPLACE_WITH_HUBSPOT_APP_ID
# Only events from this portal (account) are processed. Use your test account's ID while testing.
EXPECTED_PORTAL_ID=REPLACE_WITH_HUBSPOT_TEST_PORTAL_ID
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# --- Webhook ---
# The exact public URL HubSpot calls, including any query string. Signature checks depend on it.
WEBHOOK_PUBLIC_URL=https://your-n8n-webhook-domain.com/webhook/hubspot/contact-merge-resolver
# Local testing only. Ignored unless SANDBOX_MODE=true.
HUBSPOT_SKIP_SIGNATURE_CHECK=false
SIGNATURE_MAX_AGE_MS=300000

# --- Outputs (Slack incoming webhook, queue endpoint, sheet webhook, etc.) ---
REVIEW_QUEUE_WEBHOOK_URL=https://your-review-queue.example.com/webhook/REPLACE_WITH_PATH
AUDIT_LOG_WEBHOOK_URL=https://your-audit-log.example.com/webhook/REPLACE_WITH_PATH

# --- Tuning ---
# A search returning more candidates than this goes to review instead of merging (1-50).
MAX_CANDIDATES=10

# --- n8n host settings this workflow requires ---
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
